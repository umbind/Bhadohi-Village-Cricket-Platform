# =====================================================================
# Bhadohi Village Cricket Platform - Server Environment Variables
# NEVER commit the real .env file with actual production secrets.
# =====================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL Connection String (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bvcp_dev?schema=public"

# Authentication & Security Secrets
JWT_SECRET="replace-with-a-secure-random-256-bit-hex-secret-in-production"
JWT_EXPIRES_IN="7d"

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# CORS Whitelist (Comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# Expiry Cron Secret (Used to authenticate scheduled internal trigger)
INTERNAL_CRON_SECRET="internal-scheduler-secret-token"
